<Window x:Class="NetPulseOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSpeed Live"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="19"
        Foreground="White">
    <Window.ContextMenu>
        <ContextMenu x:Name="OverlayMenu">
            <MenuItem Header="Display Mode">
                <MenuItem x:Name="BothModeItem" Header="Both" IsCheckable="True" />
                <MenuItem x:Name="UploadOnlyModeItem" Header="Only Upload" IsCheckable="True" />
                <MenuItem x:Name="DownloadOnlyModeItem" Header="Only Download" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="Layout Orientation">
                <MenuItem x:Name="OrientationHorizontalItem" Header="Horizontal" IsCheckable="True" />
                <MenuItem x:Name="OrientationVerticalItem" Header="Vertical" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="Text Colour">
                <MenuItem x:Name="ColourWhiteItem" Header="White" IsCheckable="True" />
                <MenuItem x:Name="ColourRedItem" Header="Red" IsCheckable="True" />
                <MenuItem x:Name="ColourGreenItem" Header="Green" IsCheckable="True" />
                <MenuItem x:Name="ColourBlueItem" Header="Blue" IsCheckable="True" />
                <MenuItem x:Name="ColourYellowItem" Header="Yellow" IsCheckable="True" />
                <MenuItem x:Name="ColourCyanItem" Header="Cyan" IsCheckable="True" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Font Family">
                <MenuItem x:Name="FontSegoeItem" Header="Segoe UI" IsCheckable="True" />
                <MenuItem x:Name="FontCascadiaItem" Header="Cascadia Mono" IsCheckable="True" />
                <MenuItem x:Name="FontConsolasItem" Header="Consolas" IsCheckable="True" />
                <MenuItem x:Name="FontArialItem" Header="Arial" IsCheckable="True" />
                <MenuItem x:Name="FontCalibriItem" Header="Calibri" IsCheckable="True" />
                <MenuItem x:Name="FontVerdanaItem" Header="Verdana" IsCheckable="True" />
                <MenuItem x:Name="FontTrebuchetItem" Header="Trebuchet MS" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="Font Size">
                <MenuItem x:Name="FontSizeSmallItem" Header="Small" IsCheckable="True" />
                <MenuItem x:Name="FontSizeMediumItem" Header="Medium" IsCheckable="True" />
                <MenuItem x:Name="FontSizeLargeItem" Header="Large" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="Font Weight">
                <MenuItem x:Name="FontWeightLightItem" Header="Light" IsCheckable="True" />
                <MenuItem x:Name="FontWeightRegularItem" Header="Regular" IsCheckable="True" />
                <MenuItem x:Name="FontWeightSemiBoldItem" Header="SemiBold" IsCheckable="True" />
                <MenuItem x:Name="FontWeightBoldItem" Header="Bold" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="Opacity">
                <MenuItem x:Name="Opacity50Item" Header="50%" IsCheckable="True" />
                <MenuItem x:Name="Opacity75Item" Header="75%" IsCheckable="True" />
                <MenuItem x:Name="Opacity100Item" Header="100%" IsCheckable="True" />
            </MenuItem>
            <MenuItem x:Name="ClickThroughMenuItem" Header="Click-Through" IsCheckable="True" />
            <Separator />
            <MenuItem x:Name="HideMenuItem" Header="Hide Overlay" />
            <MenuItem x:Name="AboutMenuItem" Header="About NetSpeed Live" />
            <MenuItem x:Name="ExitMenuItem" Header="Exit" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- The initial grid matches the DEFAULT Horizontal orientation (one row,
         four columns, download first) so no layout flash occurs before
         ApplyDisplayOrientation() runs on Loaded. The same four TextBlocks are
         rearranged at runtime for Vertical (2×2) and for display modes; columns
         are fixed-width when measured so speed updates never resize the window. -->
    <Grid x:Name="RootGrid" Margin="3,2,3,2" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="UploadArrow"
                   Grid.Row="0" Grid.Column="2"
                   Text="&#8593;"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI" FontSize="19" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.6" />
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="UploadSpeed"
                   Grid.Row="0" Grid.Column="3"
                   Text="0 B/s"
                   TextAlignment="Left"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI" FontSize="19" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.6" />
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock x:Name="DownloadArrow"
                   Grid.Row="0" Grid.Column="0"
                   Text="&#8595;"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI" FontSize="19" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.6" />
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="DownloadSpeed"
                   Grid.Row="0" Grid.Column="1"
                   Text="0 B/s"
                   TextAlignment="Left"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI" FontSize="19" Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.6" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>