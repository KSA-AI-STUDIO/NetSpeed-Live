<Window x:Class="NetPulseOverlay.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NetSpeed Live"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="ProductNameText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,2,0,10" Foreground="#FF666666" />
        <TextBlock x:Name="CompanyText" HorizontalAlignment="Center" />
        <TextBlock x:Name="FounderText" HorizontalAlignment="Center" />
        <TextBlock x:Name="ContactText" HorizontalAlignment="Center" />
        <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#FF666666" />
        <Separator Margin="0,14,0,0" />
        <TextBlock Text="Support Development" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
        <TextBlock Text="If you find NetSpeed Live useful, you can support its development."
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="#FF444444" />
        <Button x:Name="DonateButton" Content="Donate via UPI" Padding="14,6" HorizontalAlignment="Center" />
        <Button x:Name="CloseButton" Content="Close" Padding="14,6" HorizontalAlignment="Center" Margin="0,12,0,0" IsCancel="True" />
    </StackPanel>
</Window>